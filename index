section{max-width:1180px;margin:auto;padding:95px 24px}.hero{min-height:650px;display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;position:relative}.hero:before{content:"";position:absolute;width:430px;height:430px;right:4%;top:8%;background:rgba(80,130,255,.13);filter:blur(90px);border-radius:50%;z-index:-1}.eyebrow{text-transform:uppercase;letter-spacing:.14em;color:#8ea5bd;font-size:11px;font-weight:700}.eyebrow span{color:var(--green)}h1,h2,h3{font-family:"Space Grotesk";margin:0}h1{font-size:clamp(52px,7vw,86px);line-height:.98;letter-spacing:-.055em;margin:18px 0 25px}h1 span,h2 span{color:var(--green)}.lead{font-size:17px;line-height:1.75;color:var(--muted);max-width:600px}.actions{display:flex;gap:12px;margin:30px 0}.primary,.secondary{padding:13px 18px;border-radius:9px;font-weight:700;font-size:13px;border:1px solid transparent}.primary{background:var(--green);color:#04131a}.secondary{border-color:var(--line);color:#dbe7f4}.hero-card{background:linear-gradient(150deg,#10243a,#091522);border:1px solid var(--line);border-radius:18px;padding:18px;box-shadow:0 30px 80px rgba(0,0,0,.3)}.chat-head{display:flex;align-items:center;gap:11px;padding-bottom:16px;border-bottom:1px solid var(--line)}.avatar{width:42px;height:42px;border-radius:12px;background:rgba(100,231,196,.09);display:grid;place-items:center;color:var(--green);font-size:20px}.chat-head small{display:block;color:#71869c;font-size:11px;margin-top:3px}.chat{min-height:330px;padding:20px 4px;display:flex;flex-direction:column;gap:10px}.msg{max-width:80%;padding:10px 13px;border-radius:11px;font-size:12px;line-height:1.5}.bot{background:#12253a;border-top-left-radius:4px;color:#c9d8e8}.user{align-self:flex-end;background:#ddfff5;color:#12322b;border-top-right-radius:4px}.chat-open{width:100%;padding:12px;background:rgba(100,231,196,.07);border:1px solid rgba(100,231,196,.2);color:var(--green);border-radius:8px;font-weight:700}
.band{max-width:none;border-block:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr);padding:0}.band div{padding:25px 5%;border-right:1px solid var(--line)}.band div:last-child{border:0}.band strong{display:block;font:600 15px "Space Grotesk";margin-bottom:5px}.band small{color:#71859a}
.heading{max-width:700px}.heading.center{text-align:center;margin:auto}.heading p,.card p,.step p{color:var(--muted);line-height:1.7;font-size:14px}.heading h2{font-size:48px;letter-spacing:-.04em;margin:15px 0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:45px}.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:25px;min-height:220px}.icon{width:42px;height:42px;border-radius:10px;background:rgba(100,231,196,.07);border:1px solid rgba(100,231,196,.12);display:grid;place-items:center;color:var(--green);font-size:20px}.card h3{font-size:19px;margin:30px 0 8px}.number{float:right;color:#60758d;font-size:11px}
