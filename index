footer{border-top:1px solid var(--line);max-width:1180px;margin:auto;padding:35px 24px 50px;display:flex;justify-content:space-between;color:#71859a;font-size:12px}footer strong{color:#d6e3ef}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);z-index:30;display:none;place-items:center;padding:18px}.modal.active{display:grid}.window{width:min(470px,100%);background:#0a1727;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 30px 100px #000}.windowhead{padding:15px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between}.close{background:none;border:0;color:#9eb1c5;font-size:20px}.messages{height:390px;padding:18px;overflow:auto;display:flex;flex-direction:column;gap:10px}.quick{display:flex;gap:7px;flex-wrap:wrap;padding:0 15px 12px}.quick button{background:transparent;border:1px solid var(--line);color:#91a5ba;border-radius:20px;padding:7px 10px;font-size:11px}.input{display:flex;gap:8px;padding:12px 15px;border-top:1px solid var(--line)}.input input{flex:1;background:#07121f;border:1px solid var(--line);border-radius:8px;padding:11px;color:white;outline:0}.input button{width:42px;border:0;border-radius:8px;background:var(--green)}
@media(max-width:850px){.links{display:none}.hero,.flow{grid-template-columns:1fr}.hero-card{display:none}.band{grid-template-columns:1fr 1fr}.band div:nth-child(2){border-right:0}.grid,.timeline{grid-template-columns:1fr}.arch{display:grid;grid-template-columns:1fr 1fr}.arr{display:none}.hero{min-height:auto;padding-top:75px}footer{flex-direction:column;gap:15px}}
