</main>

<footer><div><strong>ShopMate AI</strong> — Online Shopping Chatbot</div><div>Amazon Lex V2 • AWS Lambda • CloudWatch</div><a href="https://github.com/" target="_blank">View GitHub ↗</a></footer>

<div class="modal" id="modal">
  <div class="window">
    <div class="windowhead"><strong>🤖 ShopMate AI</strong><button class="close" onclick="closeChat()">×</button></div>
    <div class="messages" id="messages">
      <div class="msg bot">Welcome to ShopMate AI. May I have your name?</div>
    </div>
    <div class="quick">
      <button onclick="send('I want to shop')">I want to shop</button>
      <button onclick="send('Show me how it works')">How it works</button>
      <button onclick="send('Start shopping')">Start shopping</button>
    </div>
    <form class="input" onsubmit="event.preventDefault();send(document.getElementById('input').value);document.getElementById('input').value=''">
      <input id="input" placeholder="Type your message..."><button>➤</button>
    </form>
  </div>
</div>

<script>
function openChat(){document.getElementById('modal').classList.add('active')}
function closeChat(){document.getElementById('modal').classList.remove('active')}
function send(text){
 if(!text||!text.trim())return;
 const box=document.getElementById('messages');
 box.innerHTML+=`<div class="msg user">${escapeHtml(text)}</div>`;
 let reply="Demo mode: your message was received. Connect this interface to the live Amazon Lex V2 backend to process the complete shopping flow.";
 const t=text.toLowerCase();
 if(t.includes("shop")) reply="Great! May I have your name?";
 if(t.includes("work")) reply="ShopMate collects customer details, asks for the product and quantity, then confirms the request.";
 setTimeout(()=>{box.innerHTML+=`<div class="msg bot">${reply}</div>`;box.scrollTop=box.scrollHeight},500);
}
function escapeHtml(s){return s.replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
document.getElementById('modal').addEventListener('click',e=>{if(e.target.id==='modal')closeChat()});
</script>
